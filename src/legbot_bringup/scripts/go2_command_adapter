#!/usr/bin/python3
"""Translate body velocity and GO2 mode requests into controller inputs."""
import time

from control_input_msgs.msg import Inputs
from std_msgs.msg import Int32
from legbot_platform.velocity_guard import VelocityGuard, run


class CommandAdapter(VelocityGuard):
    def __init__(self):
        super().__init__('go2_command_adapter', '/cmd_vel')
        self.disarm()
        self.pub = self.create_publisher(Inputs, '/control_input', 10)
        self.create_subscription(Int32, '/go2/control_mode', self.control_mode, 10)

    def disarm(self):
        self.mode = 0
        self.last_mode = float('-inf')

    def control_mode(self, msg):
        if msg.data in (1, 2, 3, 4):
            self.mode = msg.data
            self.last_mode = time.monotonic()

    def publish(self):
        now = time.monotonic()
        vx, vy, wz = self.allowed_velocity(now)
        msg = Inputs()
        msg.ly, msg.lx, msg.rx = float(vx), float(-vy), float(-wz)
        msg.command = self.mode if now-self.last_mode < 0.1 and (self.mode != 3 or self.map_permits_motion(now)) else 0
        self.pub.publish(msg)


if __name__ == '__main__':
    run(CommandAdapter)
