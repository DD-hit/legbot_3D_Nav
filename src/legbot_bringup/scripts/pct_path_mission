#!/usr/bin/env python3
"""Transform a Building-local PCT route into odom and execute it as one mission."""

import json
import math
import sys
import numpy as np
from scipy.spatial.transform import Rotation

import rclpy
from geometry_msgs.msg import PoseStamped, TransformStamped
from nav_msgs.msg import Odometry, Path
from rclpy.clock import Clock, ClockType
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy, qos_profile_sensor_data
from rclpy.time import Time
from scan_planner.msg import Bspline
from std_msgs.msg import Bool, Header, String
from tf2_ros import Buffer, TransformException, TransformListener
from tf2_ros.static_transform_broadcaster import StaticTransformBroadcaster


def yaw_from_quaternion(q):
    return math.atan2(
        2.0 * (q.w * q.z + q.x * q.y),
        1.0 - 2.0 * (q.y * q.y + q.z * q.z))


def transform_xyz(local, odom, building, spawn):
    """Building-local -> Gazebo world -> current FAST-LIO odom."""
    lx, ly, lz = local
    ox, oy, oz, odom_yaw = odom
    bx, by, bz, building_yaw = building
    sx, sy, sz, spawn_yaw = spawn

    cb, sb = math.cos(building_yaw), math.sin(building_yaw)
    world_x = bx + cb * lx - sb * ly
    world_y = by + sb * lx + cb * ly
    world_z = bz + lz

    yaw = odom_yaw - spawn_yaw
    c, s = math.cos(yaw), math.sin(yaw)
    dx, dy = world_x - sx, world_y - sy
    return (
        ox + c * dx - s * dy,
        oy + s * dx + c * dy,
        oz + world_z - sz,
    )


def transform_point(point, transform, inverse=False):
    offset, rotation = transform
    if inverse:
        return rotation.inv().apply(np.subtract(point, offset)).tolist()
    return (rotation.apply(point) + offset).tolist()


def transform_heading(yaw, rotation):
    forward = rotation.apply([math.cos(yaw), math.sin(yaw), 0.])
    return math.atan2(forward[1], forward[0])


class PctPathMission(Node):
    def __init__(self):
        super().__init__('pct_path_mission')
        self.input_topic = str(self.declare_parameter(
            'input_topic', '/pct_path_raw').value)
        self.output_topic = str(self.declare_parameter(
            'output_topic', '/pct_path').value)
        self.goal_topic = str(self.declare_parameter(
            'goal_topic', '/scan/goal').value)
        self.odom_topic = str(self.declare_parameter(
            'odom_topic', '/fast_lio/odometry_base').value)
        self.ready_topic = str(self.declare_parameter(
            'ready_topic', '/go2/demo_ready').value)
        self.frame_id = str(self.declare_parameter('frame_id', 'odom').value)
        self.base_frame = self.declare_parameter('base_frame', 'base').value
        self.pct_frame_id = str(self.declare_parameter(
            'pct_frame_id', 'building_pct').value)
        self.publish_map_tf = bool(self.declare_parameter(
            'publish_map_tf', True).value)
        self.use_map_localization = self.declare_parameter('use_map_localization', False).value
        self.tasks = None
        self.web = None

        if not self.use_map_localization:
            self.building = (
                float(self.declare_parameter('building_x', 13.0).value),
                float(self.declare_parameter('building_y', 0.0).value),
                float(self.declare_parameter('building_z', 0.0).value),
                float(self.declare_parameter('building_yaw', 0.0).value),
            )
            self.spawn = (
                float(self.declare_parameter('spawn_x', -27.0).value),
                float(self.declare_parameter('spawn_y', 6.0).value),
                float(self.declare_parameter('spawn_z', 0.50).value),
                float(self.declare_parameter('spawn_yaw', 0.0).value),
            )

        latched = QoSProfile(depth=1)
        latched.reliability = ReliabilityPolicy.RELIABLE
        latched.durability = DurabilityPolicy.TRANSIENT_LOCAL
        reliable = QoSProfile(depth=10)
        reliable.reliability = ReliabilityPolicy.RELIABLE

        self.path_pub = self.create_publisher(Path, self.output_topic, latched)
        self.goal_pub = self.create_publisher(PoseStamped, self.goal_topic, reliable)
        self.complete_pub = self.create_publisher(
            Bool, '/scan/mission_complete', latched)
        self.static_tf = StaticTransformBroadcaster(self) if self.publish_map_tf and not self.use_map_localization else None
        self.create_subscription(Path, self.input_topic, self.on_path, latched)
        self.create_subscription(
            Odometry, self.odom_topic, self.on_odom, qos_profile_sensor_data)
        self.create_subscription(Bool, self.ready_topic, self.on_ready, latched)
        self.create_subscription(
            PoseStamped, '/scan/goal_stop_ack', self.on_stop_ack, reliable)

        self.raw_path = None
        self.initial_odom = None
        self.ready = False
        self.started = False
        self.completed = False
        self.goal_stamp = None
        self.map_tf_published = False
        self.fix_stamp_ns = None
        self.request_stamp = None
        self.last_goal_ns = -1
        self.map_from_odom = None
        self.plan_accepted = False
        if self.use_map_localization:
            self.buffer = Buffer()
            self.listener = TransformListener(self.buffer, self)
            self.start_pub = self.create_publisher(PoseStamped, '/pct/localized_start', latched)
            self.permit_pub = self.create_publisher(Header, '/pct/motion_permit', latched)
            self.plan_ready_pub = self.create_publisher(Bool, '/scan/plan_ready', latched)
            self.plan_ready_pub.publish(Bool(data=False))
            self.create_subscription(String, '/localization/status', self.on_localization, latched)
            self.create_subscription(Bspline, '/scan/planning/bspline', self.on_plan, reliable)
            self.create_timer(0.2, self.tick_localized, clock=Clock(clock_type=ClockType.STEADY_TIME))
        self.complete_pub.publish(Bool(data=False))
        if self.declare_parameter('web_console', False).value:
            from waypoint_tasks import WaypointTasks
            from navigation_web import NavigationWeb
            self.tasks = WaypointTasks(self, latched)
            self.web = NavigationWeb(self, self.declare_parameter('web_port', 8765).value)
        self.get_logger().info(
            'Waiting for PCT path on %s and navigation readiness on %s' %
            (self.input_topic, self.ready_topic))

    def on_path(self, msg):
        if self.use_map_localization and (self.request_stamp is None or self.started
                or msg.header.frame_id != self.pct_frame_id or msg.header.stamp != self.request_stamp):
            return
        if len(msg.poses) < 2:
            self.get_logger().error('Rejected PCT path with fewer than two poses')
            if self.tasks:
                self.tasks.stop('failed', '目标不可达，未找到全局路线')
            return
        values = [
            (pose.pose.position.x, pose.pose.position.y, pose.pose.position.z)
            for pose in msg.poses
        ]
        if not all(math.isfinite(value) for point in values for value in point):
            self.get_logger().error('Rejected PCT path containing non-finite coordinates')
            if self.tasks:
                self.tasks.stop('failed', '规划器返回了无效坐标')
            return
        self.raw_path = msg
        self.get_logger().info('Received Building-local PCT path with %d poses' %
                               len(msg.poses))
        self.start_if_ready()

    def on_odom(self, msg):
        if self.started and not self.use_map_localization:
            return
        if self.use_map_localization and msg.header.frame_id != self.frame_id:
            return
        p = msg.pose.pose.position
        yaw = yaw_from_quaternion(msg.pose.pose.orientation)
        values = (p.x, p.y, p.z, yaw)
        if all(math.isfinite(value) for value in values):
            self.initial_odom = values
            self.odom_stamp_ns = Time.from_msg(msg.header.stamp).nanoseconds
            if not self.started:
                self.start_if_ready()

    def on_ready(self, msg):
        self.ready = bool(msg.data)
        self.start_if_ready()

    def on_localization(self, msg):
        try:
            status = json.loads(msg.data)
            if self.web:
                seed_stamp = status.get('seed_stamp_ns')
                if seed_stamp is not None and seed_stamp == self.web.expired_seed:
                    return
                if self.web.seed_pending is not None:
                    if seed_stamp != self.web.seed_pending:
                        if status['state'] != 'COLLECTING' or seed_stamp is None or seed_stamp <= self.web.seed_pending:
                            return
                        self.web.seed_pending = None
                    elif status['state'] in ('FAILED', 'LOCALIZED', 'LOST'):
                        self.web.seed_pending = None
                if seed_stamp != self.web.display_seed_stamp:
                    self.web.seed = None
                self.web.localization = status
            fix = int(status['fix_stamp_ns']) if status['state'] == 'LOCALIZED' else None
        except (KeyError, ValueError, TypeError):
            status = {}
            fix = None
        if self.tasks and self.tasks.active and status.get('automatic'):
            if status['state'] in ('COLLECTING', 'MATCHING'):
                self.tasks.stop('replan', '点云与地图不一致，停车重新定位')
            elif status['state'] in ('LOST', 'FAILED'):
                self.tasks.stop('failed', '自动定位未通过，请重新给定初始位姿')
        if fix == self.fix_stamp_ns:
            return
        if self.fix_stamp_ns is not None:
            if self.tasks and self.tasks.active:
                if not status.get('automatic'):
                    self.tasks.stop('failed', '定位已失效，请重新定位后继续')
            else:
                self.cancel_localized_mission()
        self.fix_stamp_ns = fix
        self.start_if_ready()

    def cancel_localized_mission(self):
        self.plan_accepted = False
        self.publish_permit()
        self.plan_ready_pub.publish(Bool(data=False))
        self.start_pub.publish(PoseStamped())
        stop_path = Path()
        stop_path.header.frame_id = self.frame_id
        stop_path.header.stamp = self.next_goal_stamp()
        self.path_pub.publish(stop_path)
        if self.started and not self.completed:
            stop = PoseStamped()
            stop.header = stop_path.header
            stop.pose.position.x, stop.pose.position.y, stop.pose.position.z = self.initial_odom[:3]
            stop.pose.orientation.w = 0.0 if self.tasks else 1.0
            self.goal_pub.publish(stop)
        self.raw_path = self.request_stamp = self.goal_stamp = self.map_from_odom = None
        self.started = self.completed = False
        self.get_logger().info('Cancelled localized PCT mission and revoked walking permission')

    def next_goal_stamp(self):
        self.last_goal_ns = max(self.last_goal_ns + 1, self.get_clock().now().nanoseconds)
        return Time(nanoseconds=self.last_goal_ns).to_msg()

    def publish_permit(self):
        permit = Header()
        if self.plan_accepted and not self.completed and self.fix_stamp_ns is not None:
            permit.frame_id = self.pct_frame_id
            permit.stamp = Time(nanoseconds=self.fix_stamp_ns).to_msg()
        self.permit_pub.publish(permit)

    def tick_localized(self):
        if self.tasks:
            self.tasks.tick()
        self.publish_permit()
        self.start_if_ready()

    def on_plan(self, msg):
        if not self.started or self.completed or self.plan_accepted:
            return
        if ((msg.start_time.sec, msg.start_time.nanosec) < self.goal_stamp
                or msg.order <= 0 or len(msg.pos_pts) <= msg.order
                or len(msg.knots) != len(msg.pos_pts) + msg.order + 1
                or not all(math.isfinite(knot) for knot in msg.knots)):
            return
        points = [(point.x, point.y, point.z) for point in msg.pos_pts]
        if (all(math.isfinite(value) for point in points for value in point)
                and any(math.dist(points[0][:2], point[:2]) > 1e-3 for point in points)):
            self.plan_accepted = True
            self.publish_permit()
            self.plan_ready_pub.publish(Bool(data=True))

    def request_localized_path(self):
        if self.tasks and not self.tasks.can_request():
            return
        if self.fix_stamp_ns is None or self.request_stamp is not None:
            return
        now_ns = self.get_clock().now().nanoseconds
        if self.odom_stamp_ns < self.fix_stamp_ns or not 0 <= now_ns - self.odom_stamp_ns <= 2_000_000_000:
            return
        try:
            latest = self.buffer.lookup_transform(self.pct_frame_id, self.frame_id, Time())
        except TransformException:
            return
        if Time.from_msg(latest.header.stamp).nanoseconds < self.fix_stamp_ns:
            return
        offset = latest.transform.translation
        quat = latest.transform.rotation
        self.map_from_odom = ([offset.x, offset.y, offset.z], Rotation.from_quat([quat.x, quat.y, quat.z, quat.w]))
        start = PoseStamped()
        start.header.frame_id = self.pct_frame_id
        start.header.stamp = self.next_goal_stamp() if self.tasks else Time(nanoseconds=self.odom_stamp_ns).to_msg()
        self.request_stamp = start.header.stamp
        start_xyz = transform_point(self.initial_odom[:3], self.map_from_odom)
        start.pose.position.x, start.pose.position.y, start.pose.position.z = start_xyz
        yaw = transform_heading(self.initial_odom[3], self.map_from_odom[1])
        start.pose.orientation.z, start.pose.orientation.w = math.sin(0.5*yaw), math.cos(0.5*yaw)
        if self.tasks:
            self.tasks.request_route(start)
        else:
            self.start_pub.publish(start)
        self.get_logger().info('Requested PCT route from localized base in %s: [%.3f %.3f %.3f]' %
                               (self.pct_frame_id, *start_xyz))

    def start_if_ready(self):
        if self.started or not self.ready or self.initial_odom is None:
            return
        if self.use_map_localization:
            self.request_localized_path()
        if self.raw_path is None:
            return

        stamp = self.next_goal_stamp()
        self.publish_map_transform(stamp)
        transformed = Path()
        transformed.header.frame_id = self.frame_id
        transformed.header.stamp = stamp
        points = []
        for source in self.raw_path.poses:
            local = (
                source.pose.position.x,
                source.pose.position.y,
                source.pose.position.z,
            )
            if self.use_map_localization:
                points.append(transform_point(local, self.map_from_odom, inverse=True))
            else:
                points.append(transform_xyz(local, self.initial_odom, self.building, self.spawn))

        if self.use_map_localization:
            if math.dist(points[0][:2], self.initial_odom[:2]) > 0.75 or abs(points[0][2] - self.initial_odom[2]) > 0.75:
                self.get_logger().error('Rejected PCT route: its first cell does not match the localized base/floor')
                self.raw_path = None
                if self.tasks:
                    self.tasks.stop('failed', '路线起点与当前定位不一致')
                return

        for index, point in enumerate(points):
            pose = PoseStamped()
            pose.header = transformed.header
            pose.pose.position.x, pose.pose.position.y, pose.pose.position.z = point
            if index + 1 < len(points):
                dx = points[index + 1][0] - point[0]
                dy = points[index + 1][1] - point[1]
            else:
                dx = point[0] - points[index - 1][0]
                dy = point[1] - points[index - 1][1]
            yaw = math.atan2(dy, dx)
            pose.pose.orientation.z = math.sin(0.5 * yaw)
            pose.pose.orientation.w = math.cos(0.5 * yaw)
            transformed.poses.append(pose)

        final_goal = PoseStamped()
        final_goal.header = transformed.header
        final_goal.pose = transformed.poses[-1].pose
        if self.tasks and self.tasks.active:
            yaw = self.tasks.state['headings'][self.tasks.state['index']]
            rotation = final_goal.pose.orientation
            if yaw is None:
                rotation.z = rotation.w = 0.0
            else:
                angle = transform_heading(yaw, self.map_from_odom[1].inv()) / 2
                rotation.z, rotation.w = math.sin(angle), math.cos(angle)
        self.goal_stamp = (stamp.sec, stamp.nanosec)

        # Arm final-goal latching before SCAN can publish the first spline.
        self.complete_pub.publish(Bool(data=False))
        self.goal_pub.publish(final_goal)
        self.path_pub.publish(transformed)
        self.started = True

        connector = math.dist(self.initial_odom[:3], points[0])
        self.get_logger().info(
            'PCT cross-floor mission started: connector=%.2f m, route_points=%d, '
            'entrance=[%.2f %.2f %.2f], final=[%.2f %.2f %.2f]' %
            (connector, len(points), *points[0], *points[-1]))

    def publish_map_transform(self, stamp):
        """Publish the same Building-local -> odom transform used by the route."""
        if self.map_tf_published or self.static_tf is None:
            return
        origin = transform_xyz(
            (0.0, 0.0, 0.0), self.initial_odom, self.building, self.spawn)
        yaw = (self.initial_odom[3] - self.spawn[3]) + self.building[3]
        transform = TransformStamped()
        transform.header.stamp = stamp
        transform.header.frame_id = self.frame_id
        transform.child_frame_id = self.pct_frame_id
        transform.transform.translation.x = origin[0]
        transform.transform.translation.y = origin[1]
        transform.transform.translation.z = origin[2]
        transform.transform.rotation.z = math.sin(0.5 * yaw)
        transform.transform.rotation.w = math.cos(0.5 * yaw)
        self.static_tf.sendTransform(transform)
        self.map_tf_published = True
        self.get_logger().info(
            'Published static map TF: %s -> %s, xyz=[%.2f %.2f %.2f], yaw=%.3f' %
            (self.frame_id, self.pct_frame_id, *origin, yaw))

    def on_stop_ack(self, msg):
        if not self.started or self.completed or self.goal_stamp is None:
            return
        stamp = (msg.header.stamp.sec, msg.header.stamp.nanosec)
        if stamp != self.goal_stamp:
            return
        self.completed = True
        if self.use_map_localization:
            self.publish_permit()
        if self.tasks:
            self.tasks.reached()
            return
        self.complete_pub.publish(Bool(data=True))
        self.get_logger().info('PCT cross-floor mission complete')


def self_test():
    # Default geometry: local entrance (-5.5,6) + Building x=13 gives
    # Gazebo (7.5,6). Relative to spawn (-27,6), odom entrance is x=34.5.
    result = transform_xyz(
        (-5.5, 6.0, 0.558),
        (0.0, 0.0, 0.50, 0.0),
        (13.0, 0.0, 0.0, 0.0),
        (-27.0, 6.0, 0.50, 0.0))
    assert math.isclose(result[0], 34.5, abs_tol=1e-9)
    assert math.isclose(result[1], 0.0, abs_tol=1e-9)
    assert math.isclose(result[2], 0.558, abs_tol=1e-9)
    rotated = transform_xyz(
        (-5.5, 6.0, 0.5),
        (1.0, 2.0, 0.5, math.pi / 2),
        (13.0, 0.0, 0.0, 0.0),
        (-27.0, 6.0, 0.5, 0.0))
    assert math.isclose(rotated[0], 1.0, abs_tol=1e-9)
    assert math.isclose(rotated[1], 36.5, abs_tol=1e-9)
    print('PASS PCT Building-local -> selected navigation odom mission transform')


def main():
    if '--self-test' in sys.argv:
        self_test()
        return
    rclpy.init()
    node = PctPathMission()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        # ros2 launch may forward a second SIGINT while its children are
        # already tearing down.  Treat that as an ordinary shutdown instead
        # of printing a misleading traceback from destroy_node().
        try:
            if node.web:
                node.web.close()
            node.destroy_node()
            if rclpy.ok():
                rclpy.shutdown()
        except (KeyboardInterrupt, ExternalShutdownException):
            pass


if __name__ == '__main__':
    main()
