<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="livox_sensor" params="parent">
    <xacro:arg name="lidar_x" default="0.15"/>
    <xacro:arg name="lidar_y" default="0.0"/>
    <xacro:arg name="lidar_z" default="0.15"/>
    <xacro:arg name="lidar_roll" default="0.0"/>
    <xacro:arg name="lidar_pitch" default="0.0"/>
    <xacro:arg name="lidar_yaw" default="0.0"/>
    <xacro:arg name="imu_in_lidar_xyz" default="0.011 0.02329 -0.04412"/>
    <xacro:arg name="lidar_frame" default="livox_link"/>
    <xacro:arg name="lidar_imu_frame" default="livox_imu_link"/>
    <xacro:arg name="imu_in_lidar_rpy" default="0 0 0"/>
    <!-- Simulation mount; calibrate all six values before using a real payload. -->
    <link name="$(arg lidar_frame)">
      <inertial><mass value="0.264"/><origin xyz="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="livox_mount" type="fixed">
      <parent link="${parent}"/><child link="$(arg lidar_frame)"/>
      <origin xyz="$(arg lidar_x) $(arg lidar_y) $(arg lidar_z)" rpy="$(arg lidar_roll) $(arg lidar_pitch) $(arg lidar_yaw)"/>
    </joint>
    <link name="$(arg lidar_imu_frame)">
      <inertial><mass value="0.001"/><origin xyz="0 0 0"/>
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>
    <joint name="livox_imu_joint" type="fixed">
      <parent link="$(arg lidar_frame)"/><child link="$(arg lidar_imu_frame)"/>
      <origin xyz="$(arg imu_in_lidar_xyz)" rpy="$(arg imu_in_lidar_rpy)"/>
    </joint>
    <xacro:if value="$(arg GAZEBO)">
      <gazebo reference="$(arg lidar_imu_frame)">
        <sensor name="livox_imu" type="imu"><topic>/livox/imu</topic><gz_frame_id>$(arg lidar_imu_frame)</gz_frame_id><always_on>true</always_on><update_rate>200</update_rate></sensor>
      </gazebo>
      <xacro:if value="$(arg ENABLE_LIDAR)">
        <gazebo reference="$(arg lidar_frame)">
          <sensor name="navigation_lidar" type="gpu_lidar">
            <topic>/livox/scan</topic><gz_frame_id>$(arg lidar_frame)</gz_frame_id>
            <update_rate>10</update_rate><always_on>true</always_on><visualize>false</visualize>
            <lidar><scan>
              <horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal>
              <vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.122173</min_angle><max_angle>0.907571</max_angle></vertical>
            </scan><range><min>0.1</min><max>40</max><resolution>0.01</resolution></range></lidar>
          </sensor>
        </gazebo>
      </xacro:if>
    </xacro:if>
  </xacro:macro>
</robot>
